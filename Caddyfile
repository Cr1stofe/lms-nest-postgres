{
	email {$ACME_EMAIL}
}
{$SERVER_NAME} {
	tls internal
	encode zstd gzip

	header {
		# no-referrer: nunca envia o Referer.
		Referrer-Policy "no-referrer"
		# Respeita Content-Type.
		X-Content-Type-Options "nosniff"
		# Remove banners de servidor/framework.
		-Server
		-X-Powered-By
		-Via
		# CORS
		Access-Control-Allow-Origin {header.Origin}
		Access-Control-Allow-Methods "GET,POST,PUT,DELETE,PATCH,OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, x-filename, x-visibility, if-none-match"
		Access-Control-Allow-Credentials true
		Access-Control-Max-Age 600
		Vary "Origin"
	}

	@preflight {
		method OPTIONS
	}
	handle @preflight {
		respond 204
	}

	handle_path /api/files/public/* {
		root * /files/public
		file_server
	}

	handle /api/files/private/* {
		reverse_proxy node:3000 {
			@accel header X-Accel-Redirect *
			handle_response @accel {
				root * /files/private
				rewrite * /{rp.header.X-Accel-Redirect}
				file_server
			}
		}
	}

	handle_path /files/public/* {
		root * /files/public
		file_server
	}

	handle /files/private/* {
		reverse_proxy node:3000 {
			@accel header X-Accel-Redirect *
			handle_response @accel {
				root * /files/private
				rewrite * /{rp.header.X-Accel-Redirect}
				file_server
			}
		}
	}

	handle /* {
		reverse_proxy node:3000
	}
}
